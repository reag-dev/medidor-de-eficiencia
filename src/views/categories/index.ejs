<div class="page-header">
  <%- include('../partials/page-header', { title: t('categories.index.title'), backHref: '/' }) %>
  <div class="page-header-actions">
    <a class="btn btn-secondary sketch-edge sketch-hover" href="/categories/setup">
      <%- include('../partials/icon', { name: 'star', size: 16 }) %> <%= t('categories.setup.entryButton') %>
    </a>
    <a class="btn btn-primary sketch-edge sketch-hover" href="/categories/new">
      <%- include('../partials/icon', { name: 'plus', size: 16 }) %> <%= t('categories.newCategoryLabel') %>
    </a>
  </div>
</div>

<% if (categorias.length === 0) { %>
  <p class="muted"><%= t('categories.index.empty') %></p>
<% } else { %>
  <div class="grid-menu">
    <% categorias.forEach((c, i) => { %>
      <div class="card sketch-edge sketch-in" style="--stagger-index: <%= i %>;">
        <div class="card-heading">
          <span class="color-dot" style="background: <%= c.cor %>" aria-hidden="true"></span>
          <h3 class="card-title"><%= c.nome %></h3>
        </div>
        <% if (c.descricao) { %><p class="muted"><%= c.descricao %></p><% } %>
        <% if (c.tempoDesejadoMin || c.duracaoPadraoMin || c.possuiValor) { %>
          <div class="badge-row">
            <% if (c.tempoDesejadoMin) { %><span class="badge sketch-edge badge-blue"><%= t('categories.index.goalBadge', { min: c.tempoDesejadoMin }) %></span><% } %>
            <% if (c.duracaoPadraoMin) { %><span class="badge sketch-edge badge-neutral"><%= t('categories.index.durationBadge', { min: c.duracaoPadraoMin }) %></span><% } %>
            <% if (c.possuiValor) { %>
              <span class="badge sketch-edge badge-yellow"><%= c.valorLabel || t('common.valueLabelDefault') %><% if (c.valorPadrao) { %><%= t('categories.index.defaultValuePrefix', { valor: formatNumber(c.valorPadrao) }) %><% } %></span>
            <% } %>
          </div>
        <% } %>
        <p class="muted"><%= t('categories.index.activityCount', { count: c._count.atividades }) %></p>
        <div class="card-footer">
          <a class="btn btn-secondary btn-sm sketch-edge sketch-hover" href="/categories/<%= c.id %>/edit">
            <%- include('../partials/icon', { name: 'edit', size: 14 }) %> <%= t('categories.index.editButton') %>
          </a>
          <form action="/categories/<%= c.id %>?_method=DELETE" method="POST" class="inline js-confirm-submit"
                data-confirm="<%= t('categories.index.deleteConfirm', { nome: c.nome }) %>">
            <button type="submit" class="btn btn-danger btn-sm sketch-edge sketch-hover">
              <%- include('../partials/icon', { name: 'trash', size: 14 }) %> <%= t('categories.index.deleteButton') %>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
