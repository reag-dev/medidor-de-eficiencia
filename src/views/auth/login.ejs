<h1 class="auth-title login-hero-title sketch-in" style="--stagger-index: 0;">
  <%= t('auth.login.title') %>
</h1>
<p class="auth-subtitle sketch-in" style="--stagger-index: 1;"><%= t('auth.login.subtitle') %></p>

<a class="btn btn-google sketch-edge sketch-hover sketch-in" style="--stagger-index: 2;" href="/auth/google">
  <span class="google-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
  <%= t('auth.login.googleButton') %>
</a>

<div class="divider sketch-in" style="--stagger-index: 3;"><span><%= t('auth.common.divider') %></span></div>

<form action="/login" method="POST" class="form sketch-in" style="--stagger-index: 4;">
  <div class="field">
    <label class="field-label" for="email"><%= t('auth.common.emailLabel') %></label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'mail', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="<%= t('auth.common.emailPlaceholder') %>" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="senha"><%= t('auth.login.passwordLabel') %></label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="senha" name="senha" class="input" required autocomplete="current-password" placeholder="<%= t('auth.login.passwordPlaceholder') %>" />
    </div>
    <p class="field-hint"><a href="/forgot-password"><%= t('auth.login.forgotPasswordLink') %></a></p>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover"><%= t('auth.login.submit') %></button>
</form>

<p class="auth-footer sketch-in" style="--stagger-index: 5;"><%= t('auth.login.noAccountText') %> <a href="/register"><%= t('auth.login.createAccountLink') %></a></p>
