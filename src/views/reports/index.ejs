<%- include('../partials/page-header', { title: t('reports.index.heading'), backHref: '/' }) %>

<form method="GET" action="/reports" class="filters">
  <div class="field">
    <label class="field-label" for="inicio"><%= t('activities.filters.fromLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="inicio" name="inicio" class="input" value="<%= filtros.inicio %>" required />
    </div>
  </div>
  <div class="field">
    <label class="field-label" for="fim"><%= t('activities.filters.toLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="fim" name="fim" class="input" value="<%= filtros.fim %>" required />
    </div>
  </div>
  <button type="submit" class="btn btn-secondary sketch-edge sketch-hover"><%= t('reports.filters.submit') %></button>
</form>

<div class="report-cards">
  <div class="card sketch-edge report-card sketch-in" style="--stagger-index: 0;">
    <span class="report-big-wrap">
      <span class="report-big"><%= relatorio.diasRegistrados %>/<%= relatorio.diasNoPeriodo %></span>
    </span>
    <span class="muted"><%= t('reports.stats.daysLabel') %></span>
  </div>
  <div class="card sketch-edge report-card sketch-in" style="--stagger-index: 1;">
    <span class="report-big-wrap">
      <span class="report-big"><%= relatorio.totalFormatado %></span>
    </span>
    <span class="muted"><%= t('reports.stats.totalHoursLabel') %></span>
  </div>
</div>

<h2 class="report-section-heading"><%= t('reports.categoryTimeHeading') %></h2>
<% if (relatorio.distribuicao.length === 0) { %>
  <p class="muted"><%= t('reports.categoryTimeEmpty') %></p>
<% } else { %>
  <div class="card sketch-edge">
    <ul class="bars">
      <% relatorio.distribuicao.forEach((d, i) => { %>
        <li class="sketch-in" style="--stagger-index: <%= i %>;">
          <div class="bar-label">
            <span><span class="color-dot" style="background: <%= d.cor %>" aria-hidden="true"></span> <%= d.categoria %></span>
            <span class="muted"><%= d.totalFormatado %> (<%= d.percentual %>%)</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill" style="--pct: <%= d.percentual / 100 %>; background: <%= d.cor %>"></div>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<h2 class="report-section-heading"><%= t('reports.valueByCategoryHeading') %></h2>
<% if (seriesValor.length === 0) { %>
  <p class="muted"><%= t('reports.valueByCategoryEmpty') %></p>
<% } else { %>
  <% seriesValor.forEach((serie, i) => { %>
    <div class="card sketch-edge sketch-in line-chart-card" style="--stagger-index: <%= i %>;">
      <div class="card-heading">
        <span class="color-dot" style="background: <%= serie.cor %>" aria-hidden="true"></span>
        <h3 class="card-title"><%= serie.categoria %> <span class="muted">— <%= serie.valorLabel %></span></h3>
      </div>
      <div class="line-chart-wrap">
        <svg class="line-chart" viewBox="0 0 <%= serie.geometry.totalWidth %> <%= serie.geometry.totalHeight %>" preserveAspectRatio="none" role="img"
             aria-label="<%= t('reports.chart.ariaLabel', { valorLabel: serie.valorLabel, categoria: serie.categoria, min: formatNumber(serie.geometry.minY), max: formatNumber(serie.geometry.maxY) }) %>">
          <% if (serie.geometry.points) { %>
            <polyline points="<%= serie.geometry.points %>" pathLength="1" style="stroke: <%= serie.cor %>" />
          <% } %>
          <% serie.pontos.forEach((p, j) => { %>
            <circle cx="<%= serie.geometry.circles[j].x %>" cy="<%= serie.geometry.circles[j].y %>" r="5" style="fill: <%= serie.cor %>" aria-hidden="true"></circle>
            <text class="line-chart-axis-label" x="<%= serie.geometry.circles[j].x %>" y="<%= serie.geometry.axisLabelY %>" text-anchor="middle" aria-hidden="true"><%= formatDate(p.horaInicio) %></text>
          <% }) %>
        </svg>
        <% serie.pontos.forEach((p, j) => { %>
          <button type="button" class="chart-point"
                  style="left: <%= (serie.geometry.circles[j].x / serie.geometry.totalWidth * 100).toFixed(2) %>%; top: <%= (serie.geometry.circles[j].y / serie.geometry.totalHeight * 100).toFixed(2) %>%;"
                  aria-label="<%= t('reports.chart.pointAriaLabel', { nome: p.nome, valor: formatNumber(p.valor), data: formatDate(p.horaInicio), hora: formatTime(p.horaInicio) }) %>">
            <span class="chart-tooltip sketch-edge" aria-hidden="true">
              <span class="chart-tooltip-name"><%= p.nome %></span>
              <span class="chart-tooltip-value"><%= formatNumber(p.valor) %></span>
              <span class="chart-tooltip-meta"><%= formatDate(p.horaInicio) %> · <%= formatTime(p.horaInicio) %></span>
            </span>
          </button>
        <% }) %>
      </div>
      <div class="line-chart-meta">
        <span><%= t('reports.chart.min', { valor: formatNumber(serie.geometry.minY) }) %></span>
        <span><%= t('reports.chart.max', { valor: formatNumber(serie.geometry.maxY) }) %></span>
      </div>
    </div>
  <% }) %>
<% } %>
