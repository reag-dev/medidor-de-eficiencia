<!DOCTYPE html>
<html lang="<%= locale %>"<% if (theme === 'dark') { %> data-theme="dark"<% } %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Sketch your time</title>
  <%- include('../partials/meta-tags', { noindex: true }) %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <% if (currentUser) { %>
    <a class="skip-link" href="#main-content"><%= t('layout.skipLink') %></a>
    <header class="topbar">
      <a class="brand" href="/">Sketch</a>
      <button type="button" id="navToggle" class="icon-btn sketch-edge sketch-hover btn-secondary nav-toggle" aria-label="<%= t('layout.navToggleAriaLabel') %>" aria-expanded="false" aria-controls="topbarActions">
        <%- include('../partials/icon', { name: 'menu', size: 20 }) %>
      </button>
      <div class="topbar-actions sketch-edge" id="topbarActions">
        <% if (currentUser.isAdmin) { %>
          <a class="icon-btn sketch-edge sketch-hover btn-secondary docs-btn" href="/docs" aria-label="<%= t('layout.docsAriaLabel') %>">
            <%- include('../partials/icon', { name: 'info', size: 18 }) %>
          </a>
        <% } %>
        <button type="button" id="localeToggle" class="icon-btn sketch-edge sketch-hover btn-secondary locale-toggle" aria-label="<%= t('layout.localeToggleAriaLabel') %>" data-next-locale="<%= locale === 'pt-BR' ? 'en-US' : 'pt-BR' %>">
          <%= locale === 'pt-BR' ? 'EN' : 'PT' %>
        </button>
        <button type="button" id="themeToggle" class="icon-btn sketch-edge sketch-hover btn-secondary theme-toggle" aria-label="<%= t('layout.themeToggleAriaLabel') %>" aria-pressed="<%= theme === 'dark' ? 'true' : 'false' %>">
          <span class="icon-sun"><%- include('../partials/icon', { name: 'sun', size: 18, color: 'var(--accent-yellow)' }) %></span>
          <span class="icon-moon"><%- include('../partials/icon', { name: 'moon', size: 18, color: 'var(--ink-soft)' }) %></span>
        </button>
        <form action="/logout" method="POST">
          <button type="submit" class="icon-btn sketch-edge sketch-hover btn-danger" aria-label="<%= t('layout.logoutAriaLabel') %>">
            <%- include('../partials/icon', { name: 'logout', size: 18 }) %>
          </button>
        </form>
      </div>
    </header>

    <main id="main-content" class="app-content">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  <% } else { %>
    <%- include('../partials/flash') %>
    <%- body %>
  <% } %>

  <%- include('../partials/confirm-toast') %>

  <script src="/js/confirm-submit.js"></script>
  <script src="/js/activity-detail-modal.js"></script>
  <script src="/js/nav-toggle.js"></script>
  <script src="/js/theme-toggle.js"></script>
  <script src="/js/locale-toggle.js"></script>
  <script src="/js/timezone.js"></script>
  <script src="/js/back-button.js"></script>
  <% if (isProd) { %>
    <script src="/js/register-sw.js"></script>
  <% } %>
</body>
</html>
